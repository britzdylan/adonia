{
  "$schema": "./node_modules/adonia/schema/adonia.schema.json",
  "registry": "bundled",
  "ref": "0.1.0",
  "paths": {
    "modules": "modules",
    "models": "app/models",
    "migrations": "database/migrations",
    "controllers": "app/controllers",
    "validators": "app/validators"
  },
  "aliases": {
    "modules": "#modules",
    "constants": "#constants",
    "models": "#models"
  },
  "installed": [
    "types",
    "constants",
    "contracts",
    "adapters",
    "api"
  ]
}
