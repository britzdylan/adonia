{
  "name": "adonis-api-stater",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    "./data": "./.adonisjs/client/data.d.ts",
    "./registry": "./.adonisjs/client/registry/index.ts"
  },
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "imports": {
    "#controllers/auth_controller": "./modules/auth/stubs/controllers/auth_controller.js",
    "#controllers/account_controller": "./modules/account/stubs/controllers/account_controller.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/user": "./modules/auth/stubs/models/user.js",
    "#models/password_reset": "./modules/auth/stubs/models/password_reset.js",
    "#models/app_notification": "./modules/notification/stubs/models/app_notification.js",
    "#models/subscription": "./modules/subscription/stubs/models/subscription.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#generated/*": "./.adonisjs/server/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#validators/auth": "./modules/auth/stubs/validators/auth.js",
    "#validators/account": "./modules/account/stubs/validators/account.js",
    "#validators/rules/unique": "./modules/auth/stubs/validators/rules/unique.js",
    "#validators/rules/exists": "./modules/auth/stubs/validators/rules/exists.js",
    "#validators/rules/valid_token": "./modules/auth/stubs/validators/rules/valid_token.js",
    "#validators/rules/valid_password": "./modules/auth/stubs/validators/rules/valid_password.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/vine_provider": "./modules/auth/stubs/providers/vine_provider.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/limiter": "./modules/auth/stubs/start/limiter.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js",
    "#modules/*": "./modules/*.js",
    "#modules/types": "./modules/types/index.js",
    "#modules/contracts": "./modules/contracts/index.js",
    "#constants/*": "./modules/constants/*.js",
    "#constants": "./modules/constants/index.js",
    "#adapters/auth": "./modules/auth/stubs/adapters/auth.js",
    "#adapters/map_user": "./modules/auth/stubs/adapters/map_user.js",
    "#adapters/lucid_user_store": "./modules/auth/stubs/adapters/lucid_user_store.js",
    "#adapters/lucid_password_reset_store": "./modules/auth/stubs/adapters/lucid_password_reset_store.js",
    "#adapters/lucid_access_token_session": "./modules/auth/stubs/adapters/lucid_access_token_session.js",
    "#adapters/account": "./modules/account/stubs/adapters/account.js",
    "#adapters/drive_avatar_storage": "./modules/account/stubs/adapters/drive_avatar_storage.js",
    "#adapters/notification": "./modules/notification/stubs/adapters/notification.js",
    "#adapters/adonis_mail_transport": "./modules/notification/stubs/adapters/adonis_mail_transport.js",
    "#adapters/lucid_app_notification_store": "./modules/notification/stubs/adapters/lucid_app_notification_store.js",
    "#adapters/creem": "./modules/creem/stubs/adapters/creem.js",
    "#adapters/creem_io_client": "./modules/creem/stubs/adapters/creem_io_client.js",
    "#adapters/subscription": "./modules/subscription/stubs/adapters/subscription.js",
    "#adapters/lucid_subscription_store": "./modules/subscription/stubs/adapters/lucid_subscription_store.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.0",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "~26.2.0",
    "eslint": "^10.9.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.5.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/limiter": "^3.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/mail": "^10.4.0",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@japa/api-client": "^3.2.1",
    "@tuyau/core": "^1.2.2",
    "@vinejs/vine": "^4.4.0",
    "adonia": "^0.2.3",
    "better-sqlite3": "^13.0.3",
    "creem_io": "^1.0.0",
    "luxon": "^3.7.2",
    "reflect-metadata": "^0.2.2"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "allowScripts": {
    "@swc/core": true,
    "better-sqlite3": true,
    "esbuild": true,
    "fsevents": true
  },
  "prettier": "@adonisjs/prettier-config"
}
