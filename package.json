{
  "name": "adonia-monorepo",
  "version": "0.2.1",
  "private": true,
  "description": "Adonia — AdonisJS module library (CLI + fixture app)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/britzdylan/adonia.git"
  },
  "bugs": {
    "url": "https://github.com/britzdylan/adonia/issues"
  },
  "homepage": "https://github.com/britzdylan/adonia#readme",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "sync-registry": "npm run sync-registry -w adonia",
    "release": "node scripts/release.mjs",
    "docs:dev": "npm run dev -w docs",
    "docs:build": "npm run build -w docs",
    "docs:preview": "npm run preview -w docs",
    "build:test-app": "cd apps && npm create adonisjs@latest adonis-test-app -- --kit=api",
    "clean:test-app": "rm -rf apps/adonis-test-app"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.7.4",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
